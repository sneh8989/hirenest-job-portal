# ==============================================================================
# HireNest — Platform Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to backend/.env:
#    cp .env.example backend/.env (or via .\scripts\setup-windows.ps1)
# 2. In production, ALWAYS generate a new random cryptographic secret key:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="HireNest API"
VERSION="1.0.0"

# Security & JWT Token Authentication
# REPLACE with a 32+ byte random string in any non-local/production deployment:
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite default for zero-setup local Windows development:
DATABASE_URL=sqlite:///./hirenest.db
# PostgreSQL for production deployment:
# DATABASE_URL=postgresql://hirenest_user:hirenest_pass@localhost:5432/hirenest_db

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,doc,png,jpg,jpeg

# AI Matching Engine Provider
# Options: "deterministic" (built-in transparent rule engine), "openai", "gemini"
AI_PROVIDER=deterministic
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Optional Notification / Email Dispatcher (Disabled by default in local dev)
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=notifications@hirenest.com

# Initial Bootstrap Admin (Used exclusively by seed script for dev/demo purposes)
# CAUTION: Demo credentials only. Change immediately upon deploying to public servers.
INITIAL_ADMIN_EMAIL=admin@hirenest.com
INITIAL_ADMIN_PASSWORD=Admin@123
